  <!-- ==================== arm turret / base gearbox ==================== -->
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="arm_mount_link"/>
    <origin xyz="-0.030 0 0.060" rpy="0 0 0"/>
  </joint>
  <link name="arm_mount_link">
    <visual><origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.150 0.150 0.060"/></geometry>
      <material name="panel_black"/></visual>
    <visual><origin xyz="-0.048 -0.075 0.055" rpy="0 0 0"/>
      <geometry><box size="0.075 0.060 0.085"/></geometry>
      <material name="gearbox_blue"/></visual>
    <visual><origin xyz="0.010 -0.078 0.055" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.026" length="0.075"/></geometry>
      <material name="motor_grey"/></visual>
    <collision><origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.150 0.150 0.060"/></geometry></collision>
    <inertial><origin xyz="0 0 0.030"/><mass value="1.60"/>
      <inertia ixx="0.0048" ixy="0" ixz="0" iyy="0.0048" iyz="0" izz="0.0060"/></inertial>
  </link>

  <!-- J1: turret yaw -->
  <joint name="joint_1_base_yaw" type="revolute">
    <parent link="arm_mount_link"/>
    <child  link="turret_link"/>
    <origin xyz="0 0 0.060" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="45.0" velocity="1.6"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>
  <link name="turret_link">
    <visual><origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.060"/></geometry>
      <material name="panel_black"/></visual>
    <visual><origin xyz="0 0.052 0.055" rpy="0 0 0"/>
      <geometry><box size="0.090 0.020 0.070"/></geometry>
      <material name="body_black"/></visual>
    <visual><origin xyz="0 -0.052 0.055" rpy="0 0 0"/>
      <geometry><box size="0.090 0.020 0.070"/></geometry>
      <material name="body_black"/></visual>
    <collision><origin xyz="0 0 0.040" rpy="0 0 0"/>
