  <!-- J5: wrist roll -->
  <joint name="joint_5_wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child  link="tool_link"/>
    <origin xyz="0 0 0.056" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="12.0" velocity="3.0"/>
