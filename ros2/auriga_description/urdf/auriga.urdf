<?xml version="1.0"?>
<!--
  auriga.urdf  |  AURIGA mobile manipulator
  4x mecanum omnidirectional base + 5 DOF arm + parallel jaw gripper
  + wrist depth camera. Branding plate on the upper arm carries a
  texture material (media/materials/textures/auriga_label.png).

  Primitive geometry only, no mesh packages required.
  ROS 2 Humble + Gazebo Classic 11.
  Generated by gen_auriga.py, edit freely.
-->
<robot name="auriga">

  <material name="body_black">  <color rgba="0.10 0.10 0.11 1.0"/></material>
  <material name="panel_black"> <color rgba="0.16 0.16 0.17 1.0"/></material>
  <material name="wheel_hub">   <color rgba="0.13 0.13 0.14 1.0"/></material>
  <material name="roller_steel"><color rgba="0.82 0.83 0.85 1.0"/></material>
  <material name="gearbox_blue"><color rgba="0.07 0.28 0.62 1.0"/></material>
  <material name="motor_grey">  <color rgba="0.30 0.31 0.33 1.0"/></material>
  <material name="alu_rail">    <color rgba="0.66 0.67 0.69 1.0"/></material>
  <material name="estop_red">   <color rgba="0.75 0.06 0.06 1.0"/></material>
  <material name="led_red">     <color rgba="0.90 0.12 0.10 1.0"/></material>
  <material name="realsense_alu"><color rgba="0.86 0.87 0.89 1.0"/></material>
  <material name="lens_glass">  <color rgba="0.12 0.16 0.22 1.0"/></material>
  <material name="lens_dark">   <color rgba="0.05 0.06 0.09 1.0"/></material>
  <material name="auriga_label">
    <texture filename="package://auriga_description/media/materials/textures/auriga_label.png"/>
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.0500" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- main chassis tub -->
    <visual><origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry><box size="0.520 0.300 0.100"/></geometry>
      <material name="body_black"/></visual>
    <!-- side pods that carry the wheel bearings -->
    <visual><origin xyz="0 0.176 0.005" rpy="0 0 0"/>
      <geometry><box size="0.470 0.052 0.090"/></geometry>
      <material name="panel_black"/></visual>
    <visual><origin xyz="0 -0.176 0.005" rpy="0 0 0"/>
      <geometry><box size="0.470 0.052 0.090"/></geometry>
      <material name="panel_black"/></visual>
    <!-- rear bulkhead: the tall plate behind the arm, e-stop side -->
    <visual><origin xyz="-0.245 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.030 0.300 0.230"/></geometry>
      <material name="body_black"/></visual>
    <!-- front payload deck: low, printed mounting rails -->
    <visual><origin xyz="0.175 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.170 0.400 0.030"/></geometry>
      <material name="panel_black"/></visual>
    <visual><origin xyz="0.175 0 0.098" rpy="0 0 0"/>
      <geometry><box size="0.130 0.360 0.018"/></geometry>
      <material name="body_black"/></visual>
    <!-- battery pack slung under the deck -->
    <visual><origin xyz="-0.040 0 -0.012" rpy="0 0 0"/>
      <geometry><box size="0.230 0.150 0.050"/></geometry>
      <material name="panel_black"/></visual>
    <!-- emergency stop: mounted at the REAR, opposite the driving direction -->
    <visual><origin xyz="-0.150 0.100 0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.024" length="0.030"/></geometry>
      <material name="estop_red"/></visual>
    <!-- voltage display -->
    <visual><origin xyz="0.030 0.152 0.062" rpy="0 0 0"/>
      <geometry><box size="0.055 0.006 0.026"/></geometry>
      <material name="led_red"/></visual>

    <collision><origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry><box size="0.520 0.400 0.100"/></geometry></collision>
    <collision><origin xyz="-0.245 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.030 0.300 0.230"/></geometry></collision>
    <inertial><origin xyz="-0.01 0 0.01"/>
      <mass value="9.0"/>
      <inertia ixx="0.135" ixy="0" ixz="0" iyy="0.215" iyz="0" izz="0.320"/>
    </inertial>
  </link>

