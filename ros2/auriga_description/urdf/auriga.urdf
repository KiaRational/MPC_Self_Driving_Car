  </joint>
  <link name="tool_link">
    <visual><origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><cylinder radius="0.026" length="0.024"/></geometry>
      <material name="motor_grey"/></visual>
    <collision><origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><cylinder radius="0.026" length="0.024"/></geometry></collision>
    <inertial><origin xyz="0 0 0.012"/><mass value="0.15"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/></inertial>
  </link>

  <joint name="tool0_joint" type="fixed">
    <parent link="tool_link"/>
    <child  link="tool0"/>
    <origin xyz="0 0 0.024" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>

  <!-- ================== Intel RealSense D435 (wrist) ==================
       Mounted on wrist_link, i.e. BEFORE the roll joint, so the image does
       not spin when the tool rolls. Body is the real D435 envelope:
       90 x 25 x 25 mm, four apertures across the front face
       (left IR imager, IR projector, right IR imager, RGB).
       Optical axis is pitched 30 deg off the gripper approach axis, which
       puts the grasp frame within 1 deg of image centre and the jaw tips
       about 10 deg below it, so the fingers frame the bottom of the view.
       To make it roll with the tool instead, reparent to tool_link.
  ================================================================== -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="wrist_link"/>
    <child  link="camera_link"/>
    <origin xyz="-0.058 0 0.105" rpy="0 -1.0472 0"/>
  </joint>
  <link name="camera_link">
    <!-- aluminium body: x forward (viewing), y along the long axis -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
      <material name="realsense_alu"/></visual>
    <!-- dark front window -->
    <visual><origin xyz="0.0125 0 0" rpy="0 0 0"/>
      <geometry><box size="0.003 0.086 0.021"/></geometry>
      <material name="lens_dark"/></visual>
    <!-- left IR imager / IR projector / right IR imager / RGB -->
    <visual><origin xyz="0.0142 0.0345 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0048" length="0.003"/></geometry>
      <material name="lens_glass"/></visual>
    <visual><origin xyz="0.0142 0.0170 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0040" length="0.003"/></geometry>
      <material name="lens_glass"/></visual>
    <visual><origin xyz="0.0142 -0.0170 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0048" length="0.003"/></geometry>
      <material name="lens_glass"/></visual>
    <visual><origin xyz="0.0142 -0.0330 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0038" length="0.003"/></geometry>
      <material name="lens_glass"/></visual>
    <!-- printed bracket back to the wrist plate -->
    <visual><origin xyz="-0.018 0 -0.014" rpy="0 0 0"/>
      <geometry><box size="0.022 0.034 0.030"/></geometry>
      <material name="panel_black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.090 0.025"/></geometry></collision>
    <inertial><mass value="0.072"/>
      <inertia ixx="5.2e-5" ixy="0" ixz="0" iyy="7.5e-6" iyz="0" izz="5.2e-5"/></inertial>
  </link>

  <!-- D435 reports depth from the LEFT infrared imager -->
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_depth_frame"/>
    <origin xyz="0.0145 0.0345 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child  link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- RGB imager: 32 mm to the right of the depth origin on a D435 -->
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_color_frame"/>
    <origin xyz="0.0145 -0.0330 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_color_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child  link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_color_optical_frame"/>

  <!-- ==================== parallel jaw gripper ========================= -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="gripper_base_link">
    <visual><origin xyz="0 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.050 0.086 0.052"/></geometry>
      <material name="body_black"/></visual>
    <visual><origin xyz="0 0 0.056" rpy="0 0 0"/>
      <geometry><box size="0.036 0.100 0.012"/></geometry>
      <material name="panel_black"/></visual>
    <collision><origin xyz="0 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.050 0.086 0.052"/></geometry></collision>
    <inertial><origin xyz="0 0 0.030"/><mass value="0.30"/>
      <inertia ixx="2.8e-4" ixy="0" ixz="0" iyy="1.8e-4" iyz="0" izz="2.6e-4"/></inertial>
  </link>

  <joint name="gripper_left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child  link="gripper_left_finger_link"/>
    <origin xyz="0 0.016 0.062" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.032" effort="40.0" velocity="0.15"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>
  <link name="gripper_left_finger_link">
    <visual><origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.026 0.012 0.070"/></geometry>
      <material name="panel_black"/></visual>
    <visual><origin xyz="0 -0.009 0.052" rpy="0 0 0"/>
      <geometry><box size="0.024 0.006 0.034"/></geometry>
      <material name="alu_rail"/></visual>
    <collision><origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.026 0.012 0.070"/></geometry></collision>
    <inertial><origin xyz="0 0 0.030"/><mass value="0.06"/>
      <inertia ixx="2.7e-5" ixy="0" ixz="0" iyy="2.9e-5" iyz="0" izz="4e-6"/></inertial>
  </link>

  <joint name="gripper_right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child  link="gripper_right_finger_link"/>
    <origin xyz="0 -0.016 0.062" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.032" effort="40.0" velocity="0.15"/>
    <mimic joint="gripper_left_finger_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>
  <link name="gripper_right_finger_link">
    <visual><origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.026 0.012 0.070"/></geometry>
      <material name="panel_black"/></visual>
    <visual><origin xyz="0 0.009 0.052" rpy="0 0 0"/>
      <geometry><box size="0.024 0.006 0.034"/></geometry>
      <material name="alu_rail"/></visual>
    <collision><origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.026 0.012 0.070"/></geometry></collision>
    <inertial><origin xyz="0 0 0.030"/><mass value="0.06"/>
      <inertia ixx="2.7e-5" ixy="0" ixz="0" iyy="2.9e-5" iyz="0" izz="4e-6"/></inertial>
  </link>

  <!-- frame a grasp planner should target: between the jaw tips -->
  <joint name="grasp_frame_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child  link="grasp_frame"/>
    <origin xyz="0 0 0.122" rpy="0 0 0"/>
  </joint>
  <link name="grasp_frame"/>


  <!-- =========================== gazebo look ========================== -->
  <gazebo reference="base_link"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="arm_mount_link"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="turret_link"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="upper_arm_link">
    <!-- Auriga/Label lives in media/materials/scripts/auriga.material -->
    <material>Auriga/Label</material>
  </gazebo>
  <gazebo reference="forearm_link"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="wrist_link"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="tool_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="gripper_base_link"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="gripper_left_finger_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="gripper_right_finger_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="camera_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="front_left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.05</mu1>      <!-- along fdir1 = roller axis: nearly free -->
    <mu2>1.10</mu2>      <!-- across the rollers: grip -->
    <fdir1>0.7071 0.7071 0</fdir1>
    <kp>1e6</kp><kd>10.0</kd><minDepth>0.0015</minDepth>
    <maxVel>0.5</maxVel>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.05</mu1>      <!-- along fdir1 = roller axis: nearly free -->
    <mu2>1.10</mu2>      <!-- across the rollers: grip -->
    <fdir1>0.7071 -0.7071 0</fdir1>
    <kp>1e6</kp><kd>10.0</kd><minDepth>0.0015</minDepth>
    <maxVel>0.5</maxVel>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.05</mu1>      <!-- along fdir1 = roller axis: nearly free -->
    <mu2>1.10</mu2>      <!-- across the rollers: grip -->
    <fdir1>0.7071 -0.7071 0</fdir1>
    <kp>1e6</kp><kd>10.0</kd><minDepth>0.0015</minDepth>
    <maxVel>0.5</maxVel>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.05</mu1>      <!-- along fdir1 = roller axis: nearly free -->
    <mu2>1.10</mu2>      <!-- across the rollers: grip -->
    <fdir1>0.7071 0.7071 0</fdir1>
    <kp>1e6</kp><kd>10.0</kd><minDepth>0.0015</minDepth>
    <maxVel>0.5</maxVel>
  </gazebo>


  <!-- ===================== omnidirectional base drive =================
       Default path: planar_move drives the body directly from /cmd_vel,
       which is robust and version independent. Wheel spin is published
       by mecanum_cmd_vel.py so the wheels turn correctly on screen.

       Physics path: delete this plugin, add the four wheel joints to the
       ros2_control block below with velocity interfaces, and let the
       anisotropic wheel friction above produce the sideways motion.
  ================================================================== -->
  <gazebo>
    <plugin name="auriga_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>50</update_rate>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <!-- ================ Intel RealSense D435 sensor ===================== -->
  <gazebo reference="camera_link">
    <sensor name="realsense_d435" type="depth">
      <update_rate>30.0</update_rate>
      <camera name="d435">
        <horizontal_fov>1.5184</horizontal_fov>   <!-- 87 deg depth FOV -->
        <image><width>848</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.105</near><far>10.0</far></clip>   <!-- D435 min-Z ~10.5 cm -->
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.004</stddev></noise>
      </camera>
      <plugin name="realsense_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>/camera</namespace></ros>
        <camera_name>depth</camera_name>
        <frame_name>camera_depth_optical_frame</frame_name>
        <min_depth>0.105</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>

    <sensor name="realsense_d435_color" type="camera">
      <update_rate>30.0</update_rate>
      <camera name="d435_rgb">
        <horizontal_fov>1.2113</horizontal_fov>   <!-- 69 deg RGB FOV -->
        <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
        <clip><near>0.10</near><far>20.0</far></clip>
      </camera>
      <plugin name="realsense_color_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>/camera</namespace></ros>
        <camera_name>color</camera_name>
        <frame_name>camera_color_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== ros2_control: arm + gripper ================= -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>

    <joint name="joint_1_base_yaw">
      <command_interface name="position"><param name="min">-2.9671</param><param name="max">2.9671</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/><state_interface name="effort"/>
    </joint>
    <joint name="joint_2_shoulder">
      <command_interface name="position"><param name="min">-1.9199</param><param name="max">1.9199</param></command_interface>
      <state_interface name="position"><param name="initial_value">-0.95</param></state_interface>
      <state_interface name="velocity"/><state_interface name="effort"/>
    </joint>
    <joint name="joint_3_elbow">
      <command_interface name="position"><param name="min">-2.6180</param><param name="max">2.6180</param></command_interface>
      <state_interface name="position"><param name="initial_value">1.15</param></state_interface>
      <state_interface name="velocity"/><state_interface name="effort"/>
    </joint>
    <joint name="joint_4_wrist_pitch">
      <command_interface name="position"><param name="min">-2.0944</param><param name="max">2.0944</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.85</param></state_interface>
      <state_interface name="velocity"/><state_interface name="effort"/>
    </joint>
    <joint name="joint_5_wrist_roll">
      <command_interface name="position"><param name="min">-3.1416</param><param name="max">3.1416</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/><state_interface name="effort"/>
    </joint>

    <joint name="gripper_left_finger_joint">
      <command_interface name="position"><param name="min">0.0</param><param name="max">0.032</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.020</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right_finger_joint">
      <param name="mimic">gripper_left_finger_joint</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <ros><namespace>/</namespace></ros>
      <!-- EDIT THIS PATH to wherever the package is installed -->
      <parameters>/ros2_ws/src/auriga_description/config/auriga_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
