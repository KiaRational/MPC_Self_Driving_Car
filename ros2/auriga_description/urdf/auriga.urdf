      <inertia ixx="0.0021" ixy="0" ixz="0" iyy="0.0021" iyz="0" izz="0.0018"/></inertial>
  </link>

  <!-- J2: shoulder pitch. This link carries the AURIGA plate. -->
  <joint name="joint_2_shoulder" type="revolute">
    <parent link="turret_link"/>
    <child  link="upper_arm_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9199" upper="1.9199" effort="60.0" velocity="1.4"/>
    <dynamics damping="0.6" friction="0.2"/>
  </joint>
  <link name="upper_arm_link">
    <!-- structural spine -->
    <visual><origin xyz="0 0 0.130" rpy="0 0 0"/>
      <geometry><box size="0.070 0.058 0.260"/></geometry>
      <material name="body_black"/></visual>
    <!-- linear rail detail down the front face -->
    <visual><origin xyz="0.040 0 0.140" rpy="0 0 0"/>
      <geometry><box size="0.016 0.040 0.230"/></geometry>
      <material name="alu_rail"/></visual>
    <!-- branding plates, one per side: the AURIGA label lives here -->
    <visual name="auriga_plate_left">
      <origin xyz="0 0.032 0.140" rpy="0 0 0"/>
      <geometry><box size="0.062 0.006 0.215"/></geometry>
      <material name="auriga_label"/>
    </visual>
    <visual name="auriga_plate_right">
      <origin xyz="0 -0.032 0.140" rpy="0 0 0"/>
      <geometry><box size="0.062 0.006 0.215"/></geometry>
      <material name="auriga_label"/>
    </visual>
    <collision><origin xyz="0 0 0.130" rpy="0 0 0"/>
      <geometry><box size="0.075 0.070 0.270"/></geometry></collision>
    <inertial><origin xyz="0 0 0.130"/><mass value="1.90"/>
      <inertia ixx="0.0118" ixy="0" ixz="0" iyy="0.0118" iyz="0" izz="0.0015"/></inertial>
  </link>

  <!-- J3: elbow pitch -->
  <joint name="joint_3_elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child  link="forearm_link"/>
    <origin xyz="0 0 0.260" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6180" upper="2.6180" effort="35.0" velocity="1.8"/>
